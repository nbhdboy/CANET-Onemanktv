# Session
SESSION_SECRET=please-change-me-to-a-long-random-string

# Optional: this email becomes admin on signup
ADMIN_EMAIL=admin@kplus1.local

# Public site URL（TapPay 3DS / 發票 notify 回呼用）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MOCK = 模擬付款；LIVE = TapPay 真實金流
PAYMENT_MODE=MOCK

# Supabase Auth (Google login). Email/password still uses the local app.
# Also add http://localhost:3000/auth/callback in Supabase Authentication → URL Configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Lets Vercel write sing_requests if the user session cookie is missing.
# Dashboard → Project Settings → API → service_role. Add in Vercel as Secret, not Config.
SUPABASE_SERVICE_ROLE_KEY=

# --- TapPay（LIVE 時必填；勿把 Partner Key 放到 NEXT_PUBLIC_）---
NEXT_PUBLIC_TAPPAY_APP_ID=
NEXT_PUBLIC_TAPPAY_APP_KEY=
NEXT_PUBLIC_TAPPAY_ENV=sandbox

TAPPAY_PARTNER_KEY=
TAPPAY_MERCHANT_ID=
TAPPAY_MERCHANT_ID_LINEPAY=
TAPPAY_PAY_BY_PRIME_URL=https://sandbox.tappaysdk.com/tpc/payment/pay-by-prime
TAPPAY_PAY_BY_TOKEN_URL=https://sandbox.tappaysdk.com/tpc/payment/pay-by-token
TAPPAY_BIND_CARD_URL=https://sandbox.tappaysdk.com/tpc/card/bind
TAPPAY_REMOVE_CARD_URL=https://sandbox.tappaysdk.com/tpc/card/remove
TAPPAY_INVOICE_API_URL=https://sandbox-invoice.tappaysdk.com/einvoice/issue
# 正式環境請改：
# TAPPAY_PAY_BY_PRIME_URL=https://prod.tappaysdk.com/tpc/payment/pay-by-prime
# TAPPAY_PAY_BY_TOKEN_URL=https://prod.tappaysdk.com/tpc/payment/pay-by-token
# TAPPAY_BIND_CARD_URL=https://prod.tappaysdk.com/tpc/card/bind
# TAPPAY_REMOVE_CARD_URL=https://prod.tappaysdk.com/tpc/card/remove
# TAPPAY_INVOICE_API_URL=https://invoice.tappaysdk.com/einvoice/issue
# LINE Pay notify（程式預設用 NEXT_PUBLIC_APP_URL）：
# https://your-domain/api/payments/tappay/linepay-notify

# 電子發票賣方（應稅 tax_type=1）
SELLER_IDENTIFIER=
SELLER_NAME=K歌+1
